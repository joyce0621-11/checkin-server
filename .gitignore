# ---------- Java / Maven 编译产物，绝对不能提交 ----------
target/
*.class
*.jar
*.war
!**/.mvn/wrapper/maven-wrapper.jar

# ---------- IDE 配置（每个人电脑不一样，提交了会互相打架） ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
.factorypath

# ---------- 系统垃圾文件 ----------
.DS_Store
Thumbs.db

# ---------- 日志文件 ----------
*.log
logs/

# ---------- ⚠️ 敏感信息：密钥、本地配置一律不提交仓库 ----------
# .env 存放 API Key（比如项目2 里调用大模型的 key）
.env
.env.*
*.env
# 本地私有配置：真实数据库密码、真实 token 写在这里，仓库里只提交 application.yml 模板
application-local.yml
application-local.properties
application-secret.yml
# 证书与密钥文件
*.pem
*.p12
*.jks
