<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 官方父工程：版本号统一在这里管，我们自己不用写一堆版本号 -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <!-- 自己项目的三件套：group(组织) + artifact(项目名) + version(版本) -->
    <groupId>com.checkin</groupId>
    <artifactId>checkin-server</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>checkin-server</name>
    <description>简易任务打卡系统 - Java 后端</description>

    <properties>
        <!-- 用 JDK 21 编译 -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- web 依赖：有了它才能写 @RestController 接口、启动内置 Tomcat -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 测试依赖：先放着，后面写单元测试用；scope=test 表示只在测试时生效，不打进最终包 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- 打包插件：能 mvn package 出一个可直接 java -jar 运行的胖 jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
